# FastAPI server. Use an empty value behind the same-origin HTTPS proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cognito Hosted UI + PKCE. Fill from `terraform output`.
# cognito_issuer
NEXT_PUBLIC_COGNITO_AUTHORITY=
# dashboard_client_id
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# cognito_domain_url
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_SCOPE=openid email profile homie/mcp:tools

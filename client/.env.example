# Local FastAPI URL for desktop development. In the hosted frontend's build env,
# set this to the AWS API's public HTTPS base URL (not localhost or an empty value).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cognito Hosted UI + PKCE. Fill from `terraform output`.
# cognito_issuer
NEXT_PUBLIC_COGNITO_AUTHORITY=
# dashboard_client_id
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# cognito_domain_url
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_SCOPE=openid email profile homie/mcp:tools

AWS_REGION=us-east-1
DYNAMODB_TABLE=homie-dev
# Optional: DynamoDB endpoint for local development (e.g. http://localhost:8001 or http://dynamodb-local:8000)
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
CORS_ORIGINS=["http://localhost:3000"]
# Real token validation is not implemented; a nonempty value disables the mock.
JWT_SECRET=
# Local development only; never enable on a public deployment.
ALLOW_MOCK_AUTH=false
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

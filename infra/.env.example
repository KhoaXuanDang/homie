# Set this to the stable HTTPS hostname assigned to the named Cloudflare Tunnel.
# For local phone testing, this must be the same origin used in Terraform dashboard_urls.
NEXT_PUBLIC_API_URL=https://homie-demo.example.com

# Cognito Hosted UI values from Terraform outputs.
NEXT_PUBLIC_COGNITO_AUTHORITY=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_SCOPE=openid email profile homie/mcp:tools

# Named tunnel token from Cloudflare Zero Trust. Never commit a real token.
CLOUDFLARE_TUNNEL_TOKEN=